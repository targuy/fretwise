      "type": "string"
    },
    "requiredCapabilities": {
      "items": {
        "type": "string"
      },
      "title": "Requiredcapabilities",
      "type": "array"
    },
    "ppq": {
      "exclusiveMinimum": 0,
      "title": "Ppq",
      "type": "integer"
    },
    "range": {
