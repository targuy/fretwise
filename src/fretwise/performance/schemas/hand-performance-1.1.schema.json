      },
      "title": "Diagnostics",
      "type": "array"
    },
    "noteExecution": {
      "items": {
        "$ref": "#/$defs/NoteExecution"
      },
      "title": "Noteexecution",
      "type": "array"
    },
    "executionGroups": {
      "items": {
        "$ref": "#/$defs/ExecutionGroup"
      },
      "title": "Executiongroups",
      "type": "array"
    },
    "expressionDetails": {
      "items": {
        "$ref": "#/$defs/ExpressionDetail"
      },
      "title": "Expressiondetails",
      "type": "array"
    },
    "transitionHints": {
