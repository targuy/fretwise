{
  "provider": "ollama",
  "codex": {
    "bin": null,
    "sandbox": "read-only",
    "extra_args": ["--skip-git-repo-check"],
    "timeout_seconds": 300
  },
  "ollama": {
    "base_url": "http://127.0.0.1:11434",
    "model": "gemma4",
    "temperature": 0.45,
    "disable_thinking": false,
    "timeout_seconds": 300
  },
  "lmstudio": {
    "base_url": "http://127.0.0.1:1234/v1",
    "model": "local-model",
    "timeout_seconds": 180
  },
  "openai": {
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-5.5",
    "api_key_env": "OPENAI_API_KEY",
    "timeout_seconds": 180
  },
  "mcp": {
    "command": null,
    "args": [],
    "timeout_seconds": 180
  },
  "paths": {
    "prompt_file": "fretwise_song_rig.prompt.md",
    "skill_file": "fretwise-song-rig.SKILL.md",
    "schema_file": "codex_song_rig.schema.json",
    "cache_dir": "..\\exports\\codex-song-rigs"
  }
}
