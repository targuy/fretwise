# Variables d'environnement du facts-worker (NAS).
# ollama NE tourne PAS sur le NAS — voir tools/extract_facts.py pour l'extraction PC.

# Politesse réseau entre morceaux (secondes).
SLEEP_BETWEEN=2

# Délai avant un nouveau passage complet (pour capter les morceaux ajoutés à songs.tsv).
RESCAN_SECONDS=3600

# Nombre de pages sources lues par morceau (plus = meilleure qualité, plus lent).
MAX_PAGES=3
