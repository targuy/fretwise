# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
maintenance_backups/
coverage.xml

# Données (ne pas versionner les datasets volumineux)
data/dadagp/
data/guitarset/
data/gaps/

# Profils joueur (données personnelles)
data/profiles/*.json

# Fichiers GP personnels
tests/fixtures/private/

# Score files (personal library — not versioned).
# Leading slash anchors these to the repo root: an unanchored "partitions/"
# matches at ANY depth and was silently swallowing the src/fretwise/partitions/
# source package too.
# Ignore the *contents*, not the directory itself: git never descends into an
# excluded directory, which would make the re-include below unreachable.
/partitions/*
# …except the GP-180 rig bank: a single hand-curated reference file (profiles,
# MIDI program numbers, genre bindings) that lives nowhere else. It was lost
# once because partitions/ was ignored wholesale; version it so it survives.
!/partitions/rigs/
/partitions/rigs/*
!/partitions/rigs/rig_bank.json
/partitions save/
_tmp_after_fingerings/

# Reference image sets (large binaries — not versioned)
data/pedals/
docs/real hands images/
data/real hands images/

# Song research datasets (large, generated — not versioned)
data/song_facts.json
data/song_raw_sources.json
data/songs_guitar_enriched_audited.json
data/songs_index_clean.tsv

# Unrelated tool log (flight-sim client — not FretWise)
WASimClient.log
WASimClient.log.old

# Large binary assets (soundfonts, samples) — too big for GitHub (> 100 MB)
data/sounds/

# ML models — large binaries delivered by GuitarDataSet, redistribute via handoff
data/models/*.onnx

# Sorties générées (benchmarks)
docs/benchmarks/*.pdf
docs/benchmarks/*.txt
docs/benchmarks/_run_log.txt

# Screenshots (debug captures)
screenshots/

# Debug artifacts at repo root
/debug.png
/*_solve.json

# Reference / handoff assets (large image sets, JSX prototypes)
/data/hand illustrations/
/design_handoff_fretwise_ui/

# UI build intermediates — regenerated by scripts/build_leather_icons.py
src/fretwise/web/static/img/icons/_*.png
src/fretwise/web/static/img/icons/*.xcf
# Superseded background art (kept locally, not versioned)
src/fretwise/web/static/img/BACKGROUND_OLD.png

# Standalone hand-viz prototype (canonical copy lives under src/fretwise/web/static/)
/web/

# Claude Code internal
.claude/

# Cloud storage secrets & local download cache (never commit credentials)
secrets.json
.fretwise/
/data/cache/

# Multi-user / OIDC environment (real secrets — keep local). See .env.example.
.env
/data/users/

# Batch tools — resumable checkpoint state (generated, machine-local)
/exports/rig_batch_state.json
/exports/finger_batch_state.json

# Windows
Thumbs.db
desktop.ini

# macOS (AppleDouble / Finder metadata — scattered on exFAT/NTFS/network volumes)
.DS_Store
.AppleDouble
.LSOverride
._*

# pixi environments
.pixi/*
!.pixi/config.toml
node_modules

# Captures datées de l'état d'un appareil (HeadRush Core) : reproductibles, volumineuses
data/devices/*/backups/

# Artefacts générés (régénérables, volumineux) — nettoyage 2026-09-10
exports/
output/
_logs/
data/_batches/
.playwright-cli/
