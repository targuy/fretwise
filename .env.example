# FretWise multi-user mode — environment configuration (Google OIDC).
#
# Copy this file to ".env" and fill in the values, then launch with
# scripts/run.sh (POSIX) or scripts/run.ps1 (Windows) — they auto-load ".env".
# ".env" is gitignored: never commit real secrets.
#
# Full reference: docs/multiuser.md
# ---------------------------------------------------------------------------

# REQUIRED — signs session cookies and encrypts per-user credentials at rest.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FRETWISE_SECRET_KEY=change-me

# REQUIRED for OAuth — the public base URL the browser is redirected back to.
# Must exactly match an "Authorized redirect URI" prefix in Google Cloud Console.
# Local dev:
FRETWISE_BASE_URL=http://localhost:8080
# The Google redirect URI to register is:  <FRETWISE_BASE_URL>/auth/callback/google
#   -> http://localhost:8080/auth/callback/google

# REQUIRED — Google OAuth 2.0 client (OAuth consent screen + Web application
# credentials at https://console.cloud.google.com/apis/credentials).
# Request the Google Drive scope so per-user Drive storage works at sign-in.
FRETWISE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
FRETWISE_GOOGLE_CLIENT_SECRET=your-client-secret

# OPTIONAL — comma-separated emails granted admin rights (access to the
# server-local partitions library, global settings, soundfont management).
FRETWISE_ADMIN_EMAILS=you@example.com

# OPTIONAL — where user records + encrypted per-user secrets are stored.
# Defaults to a per-user data dir if unset.
# FRETWISE_DATA_DIR=./data/users
# FRETWISE_STORAGE_CACHE_ROOT=./data/cache/users

# OPTIONAL — also allow email/password login alongside Google.
# Needs SMTP below to send activation links (else the link is logged to stdout).
# FRETWISE_AUTH_ENABLED=1
# FRETWISE_SMTP_HOST=smtp.example.com
# FRETWISE_SMTP_PORT=587
# FRETWISE_SMTP_USER=apikey
# FRETWISE_SMTP_PASSWORD=...
# FRETWISE_SMTP_FROM=FretWise <no-reply@example.com>
# FRETWISE_SMTP_TLS=1
