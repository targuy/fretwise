# Keep the build context small and reproducible.
.git
.github
.env
.env.*
!.env.example
.pixi
.venv
*.egg-info
__pycache__/
*.py[cod]
.mypy_cache
.ruff_cache
.pytest_cache
htmlcov
.coverage
maintenance_backups/

# macOS junk (exFAT/NTFS volumes scatter these)
._*
.DS_Store

# Large / non-runtime assets and local working files
tests/
docs/
scripts/
svg/
data/svg/
data/cache/
data/sounds/
data/*
!data/gears/
!data/gears/**
data/gears/_devices/
!data/guitars/
!data/guitars/**
!data/patterns/
!data/patterns/**
# Device catalog: the web prompt routes are generated from it, so the image
# needs it. Backups are excluded — they are dated captures, not runtime data.
!data/devices/
!data/devices/**
data/devices/*/backups/
data/devices/*/images/
!data/models/
data/models/*
!data/models/runtime_bundle.json
!data/models/finger_classifier_spec.json
!data/models/transition_cost_v3_spec.json
!data/models/phrase_window_fingering_v2_manifest.json
!data/models/phrase_window_fingering_v2_spec.json
partitions save/
"real hands images"/
_tmp_after_fingerings/
*.gp3
*.gp4
*.gp5
*.gpx
*.gp
